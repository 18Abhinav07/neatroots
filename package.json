{
  "name": "bolts-monorepo",
  "private": true,
  "description": "Neatlogs Bolts: local, private checks for AI agents while they run",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --filter @neatlogs/bolts-ui build && pnpm --filter @neatlogs/bolts build",
    "dev": "pnpm --filter @neatlogs/bolts dev",
    "test": "pnpm --filter @neatlogs/bolts test",
    "typecheck": "pnpm -r typecheck"
  }
}
